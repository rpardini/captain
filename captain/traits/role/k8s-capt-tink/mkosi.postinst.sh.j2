#!/bin/bash
# mkosi.postinst (role k8s-capt-tink) — Runs *outside* the image chroot; use 'mkosi-chroot' to run commands inside it.

# role/tink's bridge conflist goes to nerdctl's own dir: /etc/cni/net.d belongs to the cluster's CNI.
log info "Moving nerdctl's bridge CNI config out of /etc/cni/net.d..."
mkdir -p "${BUILDROOT}/etc/nerdctl/cni/net.d"
mv -v "${BUILDROOT}/etc/cni/net.d/10-bridge.conflist" "${BUILDROOT}/etc/nerdctl/cni/net.d/"
