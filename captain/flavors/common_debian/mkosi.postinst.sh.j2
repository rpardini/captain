#!/bin/bash
# mkosi.postinst — Post-installation script for the CaptainOS initrd.
# Runs *outside* the image chroot after packages are installed.
# The target filesystem is at /buildroot; use 'mkosi-chroot' to run commands inside the chroot environment.
# You can also use mkosi.extra/ for creating directories and dropping config files.
set -euo pipefail

log info "Regular CaptainOS post-install starting..."

# Ensure CA certificate bundle is generated.
log info "Generating fresh CA certificate bundle..."
mkosi-chroot update-ca-certificates --fresh

# Service enablement/disablement is handled via systemd preset files:
#   - mkosi.extra/etc/systemd/system-preset/10-captainos-tink.preset  (tink-agent and CaptainOS services)
#   - mkosi.extra/etc/systemd/system-preset/20-captainos-base.preset  (base system services and cleanup)
# mkosi applies presets automatically after post-install, so no manual
# systemctl enable/disable calls are needed here.

# Root password is set via mkosi.conf RootPassword= setting


# Set default target to multi-user (no graphical)
log info "Setting default systemd target to multi-user.target (no graphical)..."
mkosi-chroot systemctl set-default multi-user.target || true

log info "CaptainOS post-install complete."
