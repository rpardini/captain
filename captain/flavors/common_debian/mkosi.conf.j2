[Distribution]
Distribution=debian
Release=trixie

[Output]
ManifestFormat=json
Format=cpio
CompressOutput=zstd
CompressLevel=19
OutputDirectory=mkosi.output

[Build]
Incremental=yes
CacheDirectory=mkosi.cache.for.incremental

[Content]
Bootable=no
{% if flavor.include_working_apt() %}
CleanPackageMetadata=no
{% else %}
CleanPackageMetadata=yes
{% endif %}
Autologin=yes
# Skips installing documentation/man pages
WithDocs=no
# Adds .deb's found in those directories to a local apt repo that can be installed from.
PackageDirectories=
    {{ ' '.join(flavor.package_directories()) }}

# Do NOT set MakeInitrd=yes — that adds /etc/initrd-release which causes
# systemd to enter initrd mode and try switch-root to a real rootfs.
# CaptainOS uses a custom /init script (mkosi.extra/init) that transitions
# rootfs → tmpfs via switch_root before exec'ing systemd. This makes
# pivot_root(2) work for container runtimes (runc).

Packages=
    {{ "\n    ".join(flavor.sorted_flavor_packages()) }}
    # systemd and core
    systemd
    systemd-sysv # Provides poweroff, shutdown, reboot, halt, etc.
    systemd-resolved
    systemd-timesyncd
    udev
    dbus
    kmod
    dmsetup
    polkitd
    # Logging
    rsyslog
    # Shell and basic userspace
    bash
    login
    less
    util-linux
    procps
    coreutils
    findutils
    grep
    sed
    # Filesystem
    # e2fsprogs
    # dosfstools
    # lvm2
    # mdadm
    # Networking
    iproute2
    iputils-ping
    iptables
    nftables
    #curl
    ca-certificates
    # Container runtime: containerd 2.x and runc downloaded in download-tools.sh
    # Storage / provisioning tools
    # Compression
    pigz
    #zstd
    #xz-utils
    fastfetch
    pciutils # for listing PCI devices
    curl
    pv

RemoveFiles=
    /etc/initrd-release
    /usr/share/doc
    /usr/share/man
    /usr/share/info
    /usr/share/locale
    /usr/share/i18n
    /usr/share/zoneinfo
    {% if not flavor.include_working_apt() %}
    /var/cache
    {% endif %}
    /var/log
    /usr/share/bash-completion
    /usr/share/zsh
    {% if not flavor.include_hwdb() %}
    /usr/lib/udev/hwdb.d
    {% endif %}
    /usr/share/lintian
    /usr/share/bug
    /usr/share/pixmaps
    /usr/share/applications
    /usr/share/icons
    /usr/lib/systemd/catalog
    /var/lib/systemd/catalog
    /usr/lib/systemd/system/systemd-firstboot.service
    /usr/lib/systemd/system/sysinit.target.wants/systemd-firstboot.service
